# Cast hub — Anthropic NL → IDC SearchQuery (+ optional IDC MCP proxy)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# Used only by /idc-mcp-proxy (Streamable HTTP), not by /api/hub/idc-nl
CAST_HUB_IDC_MCP_UPSTREAM_URL=https://api.imaging.datacommons.cancer.gov/mcp
# Hub payload store TTL (seconds). Default 1800 — keep LiveScene chunk payloads
# available for hub-mirror sessions longer than the old 300s default.
# CAST_HUB_HTTP_PAYLOAD_TTL_SECONDS=1800
